# =============================================================================
# ARIOT production environment — template for the VPS `.env` file
#
#   cp .env.production.example .env     (on the VPS, repo root, next to
#                                        compose.production.yml)
#   chmod 600 .env
#
# `.env` is gitignored — never commit real values. Generate secrets with:
#   openssl rand -base64 32
#
# Only variables the application actually reads are listed here
# (server/env.ts is the single source of truth; compose adds infra vars).
# =============================================================================

# ─── Infrastructure (read by Docker Compose only) ────────────────────────────

# PostgreSQL superuser for the db container (internal network only).
POSTGRES_USER=ariot
POSTGRES_PASSWORD=CHANGE_ME_use_openssl_rand_base64_32
POSTGRES_DB=ariot

# Tag for built images (default: latest). Set to a git SHA per release so
# rollback is `docker compose up -d` with the previous tag.
IMAGE_TAG=latest

# Host directory bind-mounted into the web container as /var/lib/ariot/media.
# Must be pre-created and owned by uid 1000 (the container's `node` user):
#   sudo install -d -o 1000 -g 1000 /var/lib/ariot/media
MEDIA_HOST_ROOT=/var/lib/ariot/media

# ACME (Let's Encrypt) registration contact for Caddy certificate notices.
CADDY_ACME_EMAIL=admin@ariottech.com

# ─── Application — required ──────────────────────────────────────────────────

# HMAC secret for Better Auth sessions/JWTs. Generate with openssl (above).
BETTER_AUTH_SECRET=CHANGE_ME_use_openssl_rand_base64_32

# Public origin of the site — canonical URLs, sitemap, OG defaults.
NEXT_PUBLIC_SITE_URL=https://ariottech.com

# Better Auth base URL (callbacks/redirects) — the ADMIN subdomain
# (D-082/D2). The Google OAuth callback is derived from this value and MUST
# match the redirect URI registered on the Google OAuth client:
#   https://admin.ariottech.com/api/auth/callback/google
# `https://admin.ariottech.com` is also the Authorized JavaScript origin.
BETTER_AUTH_URL=https://admin.ariottech.com

# Media storage provider. Production local-filesystem deployment uses `local`.
# (`r2` is the alternative Cloudflare R2 provider — not configured here.)
MEDIA_STORAGE_PROVIDER=local

# ─── Application — email (Resend) ────────────────────────────────────────────
# Contact/quote/newsletter delivery fails hard in production without these:
# the contact/quote forms return an error to the visitor instead of faking
# success (server/mail/routing.ts fails closed when they are unset).
RESEND_API_KEY=

# Sender for ALL transactional mail (contact, quote, newsletter welcome).
#   - MUST be on a domain verified in the Resend dashboard (verify
#     ariottech.com there first — Resend rejects unverified domains).
#   - Format: "Display Name <email@domain>" or a bare email address.
#   - Leave empty until the verified sender is decided; production contact
#     email stays disabled (fails closed) until both MAIL_FROM and MAIL_TO
#     are set.
MAIL_FROM=

# Owner-approved operational inbox that receives contact + quote
# notifications. A single address (use a group alias for multiple people).
# This is a business decision — do not guess it; set the real inbox.
MAIL_TO=

# NOTE (launch blocker, I-031): Resend domain verification + a real sender
# (MAIL_FROM) + a real recipient inbox (MAIL_TO) are all required before
# contact email can deliver. Until then the forms surface an error state
# (never a fake success). Local development is unaffected: without these
# values dev keeps the historical placeholder routing and stubbed sends.
# See deploy/README.md § Email.

# ─── Application — Google OAuth (admin sign-in) ──────────────────────────────
# Set BOTH or NEITHER (a single value fails boot validation).
# Already configured on the Google OAuth client (web) —
# Authorized JavaScript origin:
#   https://admin.ariottech.com
# Authorized redirect URI (derived from BETTER_AUTH_URL above):
#   https://admin.ariottech.com/api/auth/callback/google
# NOTE: no localhost redirect URI is registered, so Google sign-in is not
# testable from a local machine until one is added in the Google Cloud
# Console (documented in deploy/README.md § Google OAuth — do not assume).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Application — optional ──────────────────────────────────────────────────

# Plausible analytics domain (omit to disable). Must ALSO be set as a build
# arg (baked into the client bundle): edit compose.production.yml build args
# or rebuild with --build-arg NEXT_PUBLIC_PLAUSIBLE_DOMAIN=ariottech.com.
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# External origin for served media. Leave unset: local media URLs stay
# site-relative (/media/...) and are delivered by the app via Caddy.
# MEDIA_PUBLIC_BASE_URL=

# HMAC secret for R2 upload completion tokens — only required when
# MEDIA_STORAGE_PROVIDER=r2 (not used in this deployment).
# MEDIA_UPLOAD_TOKEN_SECRET=

# ─── One-time operational values (shell-only, never committed) ───────────────
# Used by `pnpm admin:bootstrap --apply --production` (run inside the web
# container or any image with the scripts + DB access). Export in the shell;
# do NOT put these in .env unless you accept the exposure.
#   BOOTSTRAP_ADMIN_EMAIL=<exact Google account email of the first admin>
#   BOOTSTRAP_ADMIN_NAME=ARIOT Administrator
#   BOOTSTRAP_ADMIN_CONFIRM=GRANT_SUPER_ADMIN
