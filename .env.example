# =============================================================================
# ARIOT environment template
# Copy this file to `.env.local` and fill in any project-specific overrides.
# All env access flows through the Zod-validated `server/env.ts` module —
# never read `process.env.X` directly in source code.
# =============================================================================

# Public site URL — used for canonical URLs, sitemap, robots, and OG defaults.
# Defaults to http://localhost:3000 when unset (see server/env.ts).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Plausible Analytics domain — optional; omit to disable Plausible in dev.
# Tracks privacy-friendly page views (no cookies, no PII).
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=ariot.tech

# Database connection string for Prisma (PostgreSQL).
# Default local connection (no password):
# DATABASE_URL="postgresql://postgres@localhost:5432/ariot?schema=public"
# If your postgres user has a password:
# DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/ariot?schema=public"
DATABASE_URL="postgresql://postgres@localhost:5432/ariot?schema=public"

# Resend API key — required for transactional email (contact, quote, newsletter).
# Get yours at https://resend.com/api-keys
# RESEND_API_KEY=re_xxxxxxxxxx

# Better Auth — session/JWT signing secret.
# Generate with `openssl rand -base64 32`.
# Required in production; Better Auth auto-generates a dev fallback otherwise.
# BETTER_AUTH_SECRET=

# Better Auth public base URL (optional; inferred from the request when unset).
# Used for OAuth callbacks / redirects.
# Local dev: leave unset (defaults to http://localhost:3000).
# Production (D-082/D2): MUST be the admin subdomain, e.g.
#   BETTER_AUTH_URL=https://admin.ariottech.com
# BETTER_AUTH_URL=http://localhost:3000

# OAuth provider credentials — Google is the only configured provider (Step 2.2.3).
# Public signup is disabled (disableSignUp: true), so these only authenticate
# pre-approved admins once admin bootstrap (Step 2.2.5) is in place.
# Set BOTH values together, or neither. A single value throws a config error.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Google OAuth redirect/callback URLs (register these in the Google Cloud console):
#   Local (dev): http://localhost:3000/api/auth/callback/google
#   Production:  https://admin.ariottech.com/api/auth/callback/google
# Local development keeps the localhost origin — do NOT point local dev at the
# production admin hostname. The production callback is the admin subdomain
# (derived from BETTER_AUTH_URL above), matching the downloaded OAuth client.

# =============================================================================
# TRANSACTIONAL EMAIL ROUTING (D2 — I-031)
# Contact + quote notifications route through Resend. Sender and recipient are
# env-driven (server/mail/routing.ts) — never hardcoded placeholders.
# =============================================================================
# Sender address. MUST be on a domain verified with Resend (delivery is
# rejected otherwise). Either a bare email or a display-name form.
# MAIL_FROM=ARIOT Technologies <no-reply@ariottech.com>

# Owner-approved operational inbox that receives contact + quote notifications.
# A single address (a group alias is fine). Required at send time in
# production; when unset there, sends fail CLOSED (HTTP 500 + form error —
# never a fake success). Local dev falls back to a placeholder automatically.
# MAIL_TO=inbox@ariottech.com

# =============================================================================
# CLOUDFLARE R2 MEDIA STORAGE — Step 2.4.4 (STORAGE-1R / D-067)
# Backs the admin media library uploads (signed PUT → promote to public key).
# Optional at boot: a Phase 1 static deploy has no media storage. R2-backed
# server code calls getR2Config() and throws if the set is incomplete.
# Create the bucket + API token at https://dash.cloudflare.com → R2.
# One bucket per environment (e.g. ariot-media-dev, ariot-media-prod).
# =============================================================================
# R2_ACCOUNT_ID=<your-cloudflare-account-id>
# R2_ACCESS_KEY_ID=<your-r2-access-key-id>
# R2_SECRET_ACCESS_KEY=<your-r2-secret-access-key>
# R2_BUCKET_NAME=ariot-media-dev

# Public base URL for served R2 media (custom domain or r2.dev public bucket).
# Optional — when unset, media URLs fall back to site-relative /{storageKey}.
# R2_PUBLIC_BASE_URL=https://media.ariot.tech

# HMAC-SHA256 secret for upload completion tokens (15-min lifetime, jti-bound).
# Generate with `openssl rand -base64 32`. Required when R2 storage is enabled.
# MEDIA_UPLOAD_TOKEN_SECRET=

# =============================================================================
# MEDIA STORAGE PROVIDER — Step 2.4.4 (D-068)
# Provider abstraction: 'local' (persistent VPS filesystem, default) or 'r2'
# (Cloudflare R2, STORAGE-1R / D-067). Unset → 'local' in development;
# production must declare the provider explicitly.
# =============================================================================
# MEDIA_STORAGE_PROVIDER=local

# Absolute provider root for the 'local' provider. Contains tmp/ (in-progress
# uploads) and public/ (served media). Must be absolute, outside the Next.js
# public/ directory, and on a persistent volume (not the deploy directory).
# Production example: /var/lib/ariot/media
# Dev example: a sibling of the repo, e.g. F:/My_projects/ariot-media-dev
# MEDIA_LOCAL_ROOT=/var/lib/ariot/media

# Optional external origin for locally served media.
# When unset, local media URLs are site-relative: /media/products/...
# MEDIA_PUBLIC_BASE_URL=https://media.ariot.tech

# =============================================================================
# ADMIN BOOTSTRAP — Step 2.2.5
# Run once via: pnpm admin:bootstrap --apply
# Never set real values here. Set these in your shell or a local .env override.
# =============================================================================

# Email of the first ARIOT administrator. Must exactly match the Google account
# the admin will use. Normalized to lowercase+trimmed before use.
# BOOTSTRAP_ADMIN_EMAIL=

# Display name for the admin user (default: "ARIOT Administrator").
# BOOTSTRAP_ADMIN_NAME=ARIOT Administrator

# Confirmation gate — must be exactly this string to allow writes.
# BOOTSTRAP_ADMIN_CONFIRM=GRANT_SUPER_ADMIN
